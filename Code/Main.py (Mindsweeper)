#This is where the game logic is.
#This functions builds the board
def board_building():
    #modify the actual board list
    global board
    board = []
    #this is a nested loop (loop in a loop).
    #The outer loop goes through each row, the inner loop goes through each column
    for r in range(ROWS):
        row = []
        for c in range(COLS):
            #Each cell is a dictionary that stores 4 things about that square.
            row.append({
                # is there a mine?
                "mine": False,
                # has the player clicked on the square?
                "revealed": False,
                #is there a flag here?
                "flagged": False,
                #How many mines are around the cell? (out of 8 surrounding cells.)
                "count": 0
            })
        board.append(row)

def count_neighbours():
    #This goes through every cell on the board
    for r in range(ROWS):
        for c in range(COLS):
            #reset the count to 0 before checking this cell
            board[r][c]["count"] = 0
            #Loop through the 8 directions using the Directions list
            for change_row, change_column in Directions:
                neighbour_row = r + change_row
                neighbour_column = c + change_column
                #makes sure the neighbour cell is actually on the board.
                if 0 <= neighbour_row < ROWS and 0 <= neighbour_column < COLS:
                    if board[neighbour_row][neighbour_column]["mine"]:
                        #if the neighbour is a mine, add 1 to the cell's count
                        board[r][c]["count"] += 1

def reveal_cell(r,c):
    #These are the base cases. Conditions that stop the function from going on further
    #out of bounds vertically
    if r < 0 or r >= ROWS: return
    #horizontally out of bounds
    elif c < 0 or c>= COLS: return
    #already covered, so skip
    elif board[r][c]["revealed"]: return
    #already flagged, skip
    elif board[r][c]["flagged"]: return
    #never automatically reveal a mine
    elif board[r][c]["mine"]: return
    #mark as revealed and update how it looks on the screen
    board[r][c]["revealed"] = True
    draw_cell(r,c)
    #If the cell has 0 mines nearby, automatically reveal all the 8 neighbouring cells too
    #This is called recursion, where the function calls itself on each neighbour. Those
    #neighbours call it on their neighbours, and so on.
    if board[r][c]["count"] == 0:
        for change_row, change_column in Directions:
            reveal_cell(r + change_row, c + change_column)
#this function will basically draw the cells/squares to be more compatible with player
#interactions
def draw_cell(r,c):
    #get data for this cell and its button widget
    cell = board[r][c]
    button = buttons[r][c]
    if cell["flagged"]:
        #F means flagged, with a yellow background so it looks good and stands out.
        button.config(text="F", bg="#ffe270", state = "normal", relief = "raised")
        #state determines if the button can be clicked or not. It's normal right now, so it
        #can be clicked
        #relief is like the 3D appearance of the button. Raised means it looks raised and not
        #clicked.
        #cell hasn't been clicked yet, show it as a blank grey button.)
    elif not cell["revealed"]:
        button.config(text="", bg="grey", state="normal", relief = "raised")
    elif cell["mine"]:
        #X means bomb
        button.config(text="X", bg = "#c72c2c", state="disabled", relief = "sunken")
        #here, state is disabled, meaning it can't be clicked. Relief is also sunken, so the
        #button/square/cell looks pressed down.
    elif cell["count"] > 0:
        button.config(text=str(cell["count"]), bg = "grey", state="disabled", relief =
                      "sunken", disabledforeground = COLORS[cell["count"]])
        #disabledforeground changes the color depending on the number of mines around the
        #square. It uses the colors dictionary
    else:
        button.config(text="", bg="grey", state = "disabled", relief = "sunken")
#left click

def left_click(r,c):
    global GameOver, GameStarted, StartTime
    #if the game is over, do nothing
    if GameOver: return
    #if the cell is uncovered, do nothing
    if board[r][c]["revealed"]: return
    #if the cell is flagged, do nothing
    if board[r][c]["flagged"]: return
    #on the very first click, start the timer and place the mines. Since the mines are
    #placed here and after the first click (not the start), the first click is always safe.
    #I implemented this after some buddies tested my code and died on the first attempt.
    if not GameStarted:
        GameStarted = True
        StartTime = time.time()
        #place mines but skip the cell the player just clicked
        place_mines_safely(r, c)
        #calculate the numbers for every cell
        count_neighbours()
        #start timer
        tick()
    if board[r][c]["mine"]:
        #player clicked a mine, turning the square red and ending the game. (other mines
        #are revealed with X's)
        board[r][c]["revealed"] = True
        buttons[r][c].config(text="", bg = "red", state = "disabled")
        end_game(False)
    else:
        #Player clicked safe cell.
        reveal_cell(r,c)
        #Checks if player has won
        check_win()
#What happens when you right click. (Flag mechanics)

def right_click(r, c):
    global FlagLeft
    #game already ended, do nothing
    if GameOver: return
    #can't flag a cell that has been uncovered already
    if board[r][c]["revealed"]: return
    #cell has already been flagged, so remove the flag and give player flag back
    if board[r][c]["flagged"]:
        board[r][c]["flagged"] = False
        FlagLeft = FlagLeft + 1
    else:
        #No flag is on the square, so place a flag and remove a flag from player.
        if FlagLeft > 0:
            board[r][c]["flagged"] = True
            FlagLeft = FlagLeft - 1
    #update flag counter and redraw the cell.
    label_mines.config(text="Flags: " + str(FlagLeft))
    draw_cell(r, c)

def check_win():
    #Loop through every cell on the board
    for r in range(ROWS):
        for c in range(COLS):
            #if we find any safe cell that hasn't been revealed yet, then the game isn't
            #over, return, and keep playing.
            if board[r][c]["mine"] == False and board[r][c]["revealed"] == False:
                return
    #if we check the entire board without returning, every safe cell has been
    #revealed and the player wins!
    end_game(True)

def end_game(won):
    global GameOver
    GameOver = True
    if won:
        #calculates how long the player took
        TimeElapsed = int(time.time() - StartTime)
        button_reset.config(text = "WIN")
        label_msg.config(text = "YOU WON IN " + str(TimeElapsed) + " seconds!", fg =
                         "white")
    else:
        button_reset.config(text = "LOSS")
        label_msg.config(text = "BOOM! Close one! Try Again!", fg = "white")
        #reveals the mines the player didn't find after losing.
        for r in range(ROWS):
            for c in range(COLS):
                if board[r][c]["mine"] and not board[r][c]["revealed"]:
                    board[r][c]["revealed"] = True
                    draw_cell(r, c)
        #disables every button so the player can't keep clicking after losing.
        for r in range(ROWS):
            for c in range(COLS):
                buttons[r][c].config(state = "disabled")

def tick():
    global timerID
    #only update the timer if game is still going
    if not GameOver and GameStarted:
        elapsed = int(time.time() - StartTime)
        label_timer.config(text = "Time: " + str(elapsed))
        #tells tkinter to call tick() again after 1 second or 1000 milliseconds. We update
        #the timer every second without freezing our window
        timerID = root.after(1000, tick)

#This function places the mines
def place_mines_safely(first_r, first_c):
    currently_placed_mines = 0
    while currently_placed_mines < MINES:
        #Pick a random row and column on the board
        r = random.randint(0, ROWS - 1)
        c = random.randint(0, COLS - 1)
        #Skip if the cell was just clicked by the player for their first click. Making sure
        #the first click is never a mine, as I mentioned before.
        if (r == first_r and c == first_c):
            continue
        if not board[r][c]["mine"]:
            board[r][c]["mine"] = True
            currently_placed_mines += 1

def new_game():
    global GameOver, GameStarted, FlagLeft, StartTime, timerID
    #cancels the old timer if one is running so there isn't 2 timers going on at once
    if timerID:
        root.after_cancel(timerID)
        timerID = None
    #Resets all the game variables back to their original, starting values.
    GameOver = False
    GameStarted = False
    FlagLeft = MINES
    StartTime = 0
    #Reset all the labels and buttons back to their starting appearance
    button_reset.config(text = "     ")
    label_mines.config(text = "Flags: " + str(FlagLeft))
    label_timer.config(text="Time: 0")
    label_msg.config(text = "")
    #Builds a fresh empty board. (no mines until first click)
    board_building()
    #remove all the old cell buttons from the board frame
    for widget in board_frame.winfo_children():
        widget.destroy()
    buttons.clear()
    #creates a new button for every cell and places it in the grid
    for r in range(ROWS):
        row_buttons = []
        for c in range(COLS):
            btn = tk.Button(
                board_frame, text = "", width = 2, height = 1, font = ("Arial", 14, "bold"), bg
                = "grey", relief = "raised")
            #grid() places the button at position (row, column) in the board frame
            btn.grid(row = r, column = c)
            #Bind left click and right click with their functions
            #Use lambda with r = r and c = c to remember which cell this button belongs to
            btn.bind("<Button-1>", lambda e, r = r, c = c: left_click(r, c))
            btn.bind("<Button-3>", lambda e, r = r, c = c: right_click(r, c))
            row_buttons.append(btn)
        buttons.append(row_buttons)

def start_game():
    #Starts a new game and switch to the game screen
    new_game()
    show_screen(screen_game)
